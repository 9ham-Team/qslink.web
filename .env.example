# Docker Compose reads .env; node/npm do not automatically load this file.
# Use your real domain; DNS must point to the server before starting Caddy.
QSL_DOMAIN=qsl.example.com
# Generate a unique hex password, e.g. openssl rand -hex 32. Never reuse this placeholder.
# Hex avoids URL-encoding ambiguity in the Compose DATABASE_URL.
POSTGRES_PASSWORD=
QSL_DB_PASSWORD=
