{
  "name": "qslin-k",
  "version": "1.0.0",
  "private": true,
  "description": "QSLink · QSL 卡片交换站 — 上传你的双面 QSL 卡片，以 3D 方式展示、点赞与换卡",
  "type": "commonjs",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "dev": "node --watch server/server.js",
    "demo": "node tools/demo.mjs",
    "admin:init": "node server/init-admin.js",
    "test": "node tools/run-tests.mjs smoke",
    "test:production": "node tools/run-tests.mjs production",
    "db:import-json": "node server/import-json.js",
    "db:local": "node tools/local-postgres.mjs",
    "shot": "node tools/shot.mjs",
    "build:vue3": "node tools/build-vue3.mjs",
    "start:vue3": "node tools/start-vue3.mjs",
    "dev:vue3": "node tools/build-vue3.mjs && node tools/start-vue3.mjs --watch",
    "check:vue3": "vue-tsc --project client-vue3/tsconfig-vue3.json --noEmit",
    "test:vue3": "vitest run --config client-vue3/vitest.config-vue3.mjs",
    "test:e2e:vue3": "node tools/test-browser-vue3.mjs"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@alicloud/dm20151123": "1.11.0",
    "@alicloud/openapi-client": "0.4.15",
    "@alicloud/tea-util": "1.4.11",
    "exceljs": "4.4.0",
    "jszip": "3.10.2",
    "pg": "8.23.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@vitejs/plugin-vue": "6.0.11",
    "@vue/test-utils": "2.4.11",
    "embedded-postgres": "17.10.0-beta.17",
    "jsdom": "31.0.1",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "vue": "3.5.45",
    "vue-tsc": "3.3.14"
  },
  "overrides": {
    "@vue/test-utils": {
      "js-beautify": "1.14.8"
    }
  },
  "license": "AGPL-3.0-only",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/2580m/qslink.git"
  },
  "keywords": [],
  "author": "",
  "bugs": {
    "url": "https://github.com/2580m/qslink/issues"
  },
  "homepage": "https://github.com/2580m/qslink#readme"
}
