# 填写裸域名，不带 https:// 或路径，并提前解析到服务器 IP。
QSL_DOMAIN=qsl.example.com

# 部署前务必替换为两个不同的随机密码（建议 openssl rand -hex 32）。
# 应用密码用于连接 URL，请只用英文字母和数字，避免 URL 转义问题。
POSTGRES_PASSWORD=
QSL_DB_PASSWORD=

# 阿里云邮件推送配置；留空可以启动服务，但邮件发送不可用。
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
QSL_MAIL_REGION=cn-hangzhou
QSL_MAIL_ENDPOINT=
QSL_MAIL_FROM=
QSL_MAIL_FROM_NAME=QSLink
